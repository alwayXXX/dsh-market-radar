{
  "name": "dsh-market-radar",
  "version": "0.1.5",
  "description": "在 DeepSeek Harness 查看黄金、A 股和美股行情，支持自选、价格走势、阈值提醒、黄金市场事件与对话草稿快照。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib/index.js", "lib/client.js", "assets/icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/alwayXXX/dsh-market-radar.git" },
  "homepage": "https://github.com/alwayXXX/dsh-market-radar#readme",
  "bugs": { "url": "https://github.com/alwayXXX/dsh-market-radar/issues" },
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.3" },
  "packageManager": "pnpm@11.22.0",
  "keywords": ["dsh-plugin", "deepseek-harness", "stocks", "gold", "market-data", "ticker", "watchlist", "price-alerts", "economic-calendar"],
  "icon": "./assets/icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-shortcuts"], "immediately": true }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "smoke:package": "node scripts/package-smoke.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": { "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3" },
  "peerDependencies": { "react": ">=18.2.0 <20" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@types/node": "^26.6.6", "@types/react": "^19.3.0", "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2", "react": "^19.3.1", "react-dom": "^19.3.1", "tsx": "^4.23.15", "typescript": "^7.0.2"
  }
}
